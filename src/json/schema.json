{
    "title": "VAL Response Bank",
    "type": "object",
    "required": ["name", "version", "messages"],
    "properties": {
        "name": {
            "type": "string",
            "minLength": 1
        },
        "version": {
            "type": "string",
            "minLength": 1
        },
        "description": {
            "type": "string"
        },
        "messages": {
            "type": "object",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/message"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "message": {
            "type": "object",
            "required": ["id", "category", "step_type", "difficulty", "text"],
            "properties": {
                "id": {
                    "type": "string",
                    "minLength": 1
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "guidance",
                        "hint",
                        "error_check",
                        "encouragement",
                        "next_step",
                        "final_check",
                        "good_job"
                    ]
                },
                "step_type": {
                    "type": "string",
                    "enum": [
                        "start",
                        "simplify",
                        "distribute",
                        "combine_like_terms",
                        "isolate_variable",
                        "inverse_operation",
                        "check_work",
                        "finish",
                        "any"
                    ]
                },
                "difficulty": {
                    "type": "string",
                    "enum": ["beginner", "intermediate", "advanced"]
                },
                "tone": {
                    "type": "string",
                    "enum": ["friendly", "neutral", "encouraging", "direct"]
                },
                "text": {
                    "type": "string",
                    "minLength": 1
                },
                "tags": {
                    "type": "object",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "additionalProperties": false
        }
    }
}