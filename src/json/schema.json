{
  "title": "VAL Response Schema",
  "type": "object",
  "required": ["name", "version", "messages"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/message"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "message": {
      "type": "object",
      "required": ["id", "category", "state", "difficulty", "text"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "guidance",
            "hint",
            "verify",
            "feedback",
            "encouragement",
            "client_error",
            "server_error"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "start",
            "simplify",
            "distribute",
            "combine",
            "isolate",
            "inverse",
            "verify",
            "finish",
            "error"
          ]
        },
        "difficulty": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced"]
        },
        "tone": {
          "type": "string",
          "enum": ["friendly", "neutral", "encouraging", "direct"]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}